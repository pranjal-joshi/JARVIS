# Jackrong/Qwen3.5-2B-Claude-4.6-Opus-Reasoning-Distilled-GGUF (Apache-2.0), Qwen3.5-2B fine-tuned on Claude
# reasoning traces, Q4_K_M (~1.27 GB, text only: no vision projector), every layer on the 2 GB MX550.
# Same architecture as qwen3.5:2b, so Ollama's qwen3.5 renderer and parser give it native tool calling and
# the hub's think=false switch.
FROM hf.co/Jackrong/Qwen3.5-2B-Claude-4.6-Opus-Reasoning-Distilled-GGUF:Q4_K_M
TEMPLATE {{ .Prompt }}
RENDERER qwen3.5
PARSER qwen3.5
PARAMETER num_gpu 99
PARAMETER presence_penalty 1.5
PARAMETER temperature 1
PARAMETER top_k 20
PARAMETER top_p 0.95
