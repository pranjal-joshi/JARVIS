# Copy to .env and fill in (scripts/wsl/bootstrap.sh does this and generates tokens).
# Never commit .env.
COMPOSE_PROJECT_NAME=jarvis
# Compose files and profiles used by a plain `docker compose up -d`.
# Small-GPU laptop (MX550): COMPOSE_FILE=compose.yaml:compose.gpu-llm.yaml plus the GPU models below.
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=compose.yaml
COMPOSE_PROFILES=voice
TZ=Asia/Kolkata

# ---------- Hub ----------
# One bearer token per client. The token decides the request's `source`;
# a client cannot claim another source. "change-me" or empty = disabled.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Home Assistant Assist (voice satellites)
HUB_TOKEN_SATELLITE=change-me
# browser UI (used server-side by the UI container)
HUB_TOKEN_WEB=change-me
# phone (HA Companion / later ADB)
HUB_TOKEN_PHONE=change-me
HUB_LOG_LEVEL=info
# Browser-reachable address of the hub's event WebSocket
HUB_PUBLIC_WS_URL=ws://localhost:8700

# ---------- LLM (OpenAI-compatible) ----------
# Default: the bundled Ollama container. Point elsewhere to use another server or a cloud model.
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
# Model choice: qwen3.5:4b on CPU (default), or jarvis-2b-gpu (ollama/jarvis-2b-gpu.Modelfile:
# all layers on a 2 GB GPU, ~2-4 s replies) with EMBED_MODEL=jarvis-embed-cpu and compose.gpu-llm.yaml.
# scripts/wsl/pull-models.sh builds jarvis-* names from ollama/<name>.Modelfile.
LLM_MODEL=qwen3.5:4b
# extra models the HUD header can switch to (comma list), e.g. gemma4:e2b-it-qat
LLM_MODELS=
LLM_TIMEOUT_S=180
# JSON merged into every chat request. Turns off Qwen "thinking" (much faster on CPU).
LLM_EXTRA_BODY={"reasoning_effort":"none"}
# per-model overrides of LLM_EXTRA_BODY, e.g. {"some-model":{"reasoning_effort":"high"}}
LLM_MODEL_EXTRA={}
# Models on other OpenAI-compatible servers (llama.cpp, vLLM...), added to the HUD model picker, e.g. a bigger
# model on another machine through an SSH tunnel to this laptop's 127.0.0.1:8001:
#   {"big-model": {"base_url": "http://host.docker.internal:8001/v1", "model": "id on that server", "key_env": "ITS_KEY_VAR"}}
# PRIVACY: with one selected, conversations and tool results go to that machine.
LLM_ENDPOINTS={}
# Claude: any model id starting "claude-" (e.g. claude-haiku-5-5 in LLM_MODEL or LLM_MODELS) goes to the
# Anthropic API instead of LLM_BASE_URL. Without a key Claude models are hidden and the first local
# model is used. PRIVACY: with Claude selected, the conversation and tool results (notes, phone
# notifications, messages) are sent to Anthropic. Local models keep everything on this machine.
ANTHROPIC_API_KEY=
# low = quick spoken replies; medium/high think longer
CLAUDE_EFFORT=low

# ---------- Knowledge base ----------
# Logseq file-based graph folder (relative to this repo, or absolute on the host).
# bootstrap.sh seeds ./data/kb-graph (git-ignored) from kb/sample-graph.
KB_GRAPH_PATH=./data/kb-graph
# Graph name as Logseq shows it (the folder name); used for logseq:// deep links.
KB_GRAPH_NAME=kb-graph
QDRANT_URL=http://qdrant:6333
EMBED_BASE_URL=http://ollama:11434/v1
EMBED_MODEL=nomic-embed-text

# ---------- MCP / Home Assistant ----------
# HA's built-in "Model Context Protocol Server" integration endpoint.
# Reachable by name only when compose.ha.yaml is used.
HA_MCP_URL=http://homeassistant:8123/api/mcp
# long-lived token, ideally from a non-admin HA user
HA_TOKEN=

# ---------- Voice ----------
# faster-whisper model: small-int8 (CPU default), large-v3-turbo (GPU)
STT_MODEL=small-int8
STT_LANGUAGE=en
WHISPER_URI=tcp://whisper:10300
# Piper CPU fallback voice
# Stock voice, or a custom one dropped into voice/piper/ (e.g. jarvis-medium: see voice/README.md)
PIPER_VOICE=en_GB-alan-medium
PIPER_URI=tcp://piper:10200
# auto = VoiceStudio if reachable, else Piper | voicestudio | piper
TTS_ENGINE=auto
# VoiceStudio (cloned JARVIS voice). Key protects non-loopback + admin access.
VOICESTUDIO_URL=http://voicestudio:3900/v1
VOICESTUDIO_API_KEY=change-me
VOICESTUDIO_TTS_MODEL=tts-1
VOICESTUDIO_VOICE=jarvis

# ---------- Voice satellites (voice-only use) ----------
# A satellite's last turns are kept this long (seconds), so "yes, send it" works from clients
# that send one turn at a time (Home Assistant).
VOICE_FOLLOWUP_S=120
# Approval risks a satellite user may give by saying "yes" (external = data leaves this machine:
# web search, ask_claude). Others (destructive: texts, calls, deletes) still need the HUD or phone,
# and the satellite says so and reads the action back.
VOICE_CONFIRM_RISKS=external
# Spoken on satellites unasked: timer, skill, call (background ask_claude answers always are)
VOICE_ANNOUNCE=timer,skill,call
# Home Assistant REST, optional (uses HA_TOKEN; HA_URL defaults to HA_MCP_URL without /api/mcp).
# The token's user needs permission to call these services.
HA_URL=
# notify service for approval requests, e.g. mobile_app_pixel_9a (HA Companion app push)
HA_NOTIFY_SERVICE=
# satellite entity that speaks announcements, e.g. assist_satellite.home_assistant_voice_xxxx
HA_ANNOUNCE_ENTITY=
# opened when you tap the approval notification, e.g. https://192.168.1.20:3443
HUD_URL=
# Satellite emulator (satellite/emulator.py): wake word model, or off
# (hey_jarvis, okay_nabu, hey_mycroft, alexa)
SATELLITE_WAKE_WORD=hey_jarvis

# ---------- Expert bridge (Claude Code / opencode on the host) ----------
# Optional. bridge/expert_bridge.py runs on the host and lets JARVIS ask a stronger model,
# answer-only (no tools), after you approve each question in the HUD. Empty token = tool off.
EXPERT_BRIDGE_URL=http://host.docker.internal:8790
EXPERT_BRIDGE_TOKEN=
# claude or opencode; empty model = the CLI's default
EXPERT_DEFAULT_ENGINE=claude
EXPERT_CLAUDE_MODEL=
# effort: low, medium, high, xhigh, max (empty = CLI default). Fast + cheap: model haiku, effort low
EXPERT_CLAUDE_EFFORT=
EXPERT_OPENCODE_MODEL=opencode/big-pickle
# reasoning variant, provider-specific (e.g. minimal, low, high); empty = default
EXPERT_OPENCODE_VARIANT=

# ---------- Web search (Firecrawl, free plan: 1,000 credits/month, about 2 per search) ----------
# Key from firecrawl.dev (sign up, no card). Empty = web_search tool off.
# The query leaves this machine, so each search asks for approval unless WEB_SEARCH_APPROVAL=false.
FIRECRAWL_API_KEY=
WEB_SEARCH_APPROVAL=true

# ---- approvals ----
# Risk levels that wait for your approval in the HUD/phone (read, write, external, destructive).
# Everything else runs straight away and is audited. external = data leaves this machine.
APPROVAL_RISKS=destructive,external
# Tools the model never sees or may call (internal names, comma list). Default: free-form phone control.
MODEL_HIDDEN_TOOLS=adb_tap,adb_type,adb_shell,adb_install,adb_uninstall,adb_connect
# Local models get only this many tools that match the request (plus get_time, calculate, kb_search);
# small models choose far better from a short list. 0 = offer every tool. Claude always gets them all.
TOOL_SELECT_K=6
# The local model's context window (match OLLAMA_CONTEXT_LENGTH); long conversations are trimmed to fit
LLM_CONTEXT_TOKENS=8192
# search_notes ignores notes scoring below this (0-1)
KB_MIN_SCORE=0.6
# Where you live, for "weather at home" (empty = the first place on the jarvis/location page)
HOME_PLACE=
# Time, dates, maths, weather, timers, tasks answered by code without the model (~0.4 s)
FAST_PATHS=true
# Rules, budgets and timed grants for what runs without asking (policy/policy.yaml, read-only in the hub).
# Without the file, APPROVAL_RISKS alone decides.
POLICY_FILE=../policy/policy.yaml
# Ollama: keep the model loaded (-1 = always); a cold load is ~13 s on a 2 GB GPU
OLLAMA_KEEP_ALIVE=-1

# ---- device bridge (bridge/device_bridge.py, runs on the host) ----
# Empty token = the win_* and adb_* tools are off. Generate one: python -c "import secrets;print(secrets.token_urlsafe(32))"
DEVICE_BRIDGE_URL=http://host.docker.internal:8791
DEVICE_BRIDGE_TOKEN=
# adb from Android platform-tools (portable is fine)
ADB_PATH=adb
# hardware serials (ro.serialno) of Android devices JARVIS may touch; adb_devices shows them
DEVICE_ADB_ALLOW=
# folders JARVIS may READ (list_files, read_file): name=folder, ";" between, e.g.
# notes=C:\Users\me\Documents\Notes;recipes=D:\Recipes . Empty = none. Secrets (.env, keys, "password") are never shown.
# * = every local drive, read-only (nothing writes, moves or deletes files). Work files on the laptop become
# readable too, so use * only if that's fine for you.
DEVICE_FILES_ALLOW=
# PowerShell: powershell_read runs look-only commands freely, powershell_run asks first, file changes are refused
POWERSHELL_TIMEOUT_S=60
# apps JARVIS may open on this laptop: name=target (exe name, protocol or full path)
DEVICE_WIN_APPS=notepad=notepad.exe,calculator=calc.exe
